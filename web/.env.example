DATABASE_URL=postgresql://user:password@host/database?sslmode=require
KAIRO_INGEST_TOKEN=replace-with-at-least-32-random-bytes
KAIRO_OWNER_ID=primary
KAIRO_OWNER_NAME=Bhushan
KAIRO_TIME_ZONE=Asia/Kolkata
KAIRO_PUBLIC_URL=https://kairo.example.com
KAIRO_DASHBOARD_PASSWORD=replace-with-a-strong-password
KAIRO_SESSION_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CALENDAR_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=https://kairo.example.com/api/context/google-calendar/callback
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
APPLE_MUSIC_TEAM_ID=replace-with-apple-developer-team-id
APPLE_MUSIC_KEY_ID=replace-with-media-services-key-id
APPLE_MUSIC_PRIVATE_KEY_BASE64=replace-with-base64-encoded-p8-file
